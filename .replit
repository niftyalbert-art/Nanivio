modules = ["nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["redis"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 REQUIRE_PERSISTENT_AUTH=true npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.shared]
NANIVIO_VIDEO_CALLS_ENABLED = "true"
NANIVIO_AUDIO_CALLS_ENABLED = "true"
RESEND_FROM_EMAIL = "Nanivio <verify@naniviio.com>"
RESEND_TRANSPORT = "connector"
AVATAR_ID = "d1a1783e-3d9b-447d-8917-f5c442edb143"
MALVI_BRAIN_PROVIDER = "gemini"
