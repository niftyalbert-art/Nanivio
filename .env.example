# Nanivio production environment — set real values in Render, never commit secrets.
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://nanivio.com

# Authentication / persistent PostgreSQL (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
REQUIRE_PERSISTENT_AUTH=true

# One-time deployment bootstrap admin (use strong unique values)
NANIVIO_BOOTSTRAP_ADMIN_EMAIL=
NANIVIO_BOOTSTRAP_ADMIN_PASSWORD=
NANIVIO_BOOTSTRAP_ADMIN_PHONE=
NANIVIO_BOOTSTRAP_ADMIN_NVID=
ADMIN_MASTER_KEY=

# Agora RTC
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# GetStream Chat
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Paystack server secret (never expose to Vite/browser)
PAYSTACK_SECRET_KEY=

# International Langpretation
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_STT_ENDPOINT=

# Ghana NLP / Khaya — only enable routes backed by your subscription
KHAYA_API_KEY=
KHAYA_ASR_URL=https://translation-api.ghananlp.org/asr/v3/transcribe
KHAYA_TRANSLATION_URL=https://translation-api.ghananlp.org/v1/translate
KHAYA_TTS_URL=https://translation-api.ghananlp.org/tts/v2/synthesize
KHAYA_ASR_VERSION=v3
KHAYA_TTS_VERSION=v2
KHAYA_TRANSLATION_VERSION=v1

# Sunbird — use only real endpoints supplied by your subscription
SUNBIRD_API_KEY=
SUNBIRD_ASR_URL=
SUNBIRD_TTS_URL=

# Malvi AI (Gemini)
GEMINI_API_KEY=
MALVI_MODEL=

# Optional telecom / maps
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
VITE_GOOGLE_MAPS_API_KEY=

# Production safety
BILLING_PRODUCTION=true
BILLING_FLUSH_INTERVAL_MS=1000
NANIVIO_LANGPRETATION_ENABLED=true
LANGPRETATION_RATE_USD=0
LANGPRETATION_RATE_GHS=0

# Malvi Gemini controller policy
# Gemini is used as Malvi's reasoning/tool-selection engine. Keep this server-side.
# Recommended current stable model: gemini-3.8-flash
MALVI_MODEL=gemini-3.8-flash
