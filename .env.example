# Google Maps Platform API Key (for Live Navigation, Routes, Places, and Drive)
VITE_GOOGLE_MAPS_API_KEY=

# Paystack Server-Side Secret Key (Secure billing & Communication Balance top-ups)
PAYSTACK_SECRET_KEY=

# ========================================================
# NANIVIO MULTI-TRANSLATION ENGINES (PALABRA, KHAYA, SUNBIRD)
# ========================================================
